    "rows": [
      {
        "hero": "被遗忘者圣骑士",
        "name": "奉献",
        "code": "AHcr",
        "levels": 3,
        "description": "对大地投下祝福，治疗附近的生命盟友并灼烧敌方亡灵，同时降低其受到的治疗效果。\n\n1级 - 每秒治疗15点生命值，每秒造成15点伤害，治疗效果降低25%。持续10秒。\n2级 - 每秒治疗25点生命值，每秒造成20点伤害，治疗效果降低33%。持续10秒。\n3级 - 每秒治疗35点生命值，每秒造成25点伤害，治疗效果降低50%。持续10秒。"
      },
      {
        "hero": "被遗忘者圣骑士",
        "name": "正义之怒",
        "code": "ANcp",
        "levels": 3,
        "description": "向目标位置冲锋，对沿途的敌方地面单位造成伤害并降低其移动速度和攻击速度。\n\n1级 - 725范围，90点伤害，40%移动速度，40%攻击速度。\n2级 - 725范围，135点伤害，40%移动速度，40%攻击速度。\n3级 - 725范围，180点伤害，40%移动速度，40%攻击速度。"
      },
      {
        "hero": "被遗忘者圣骑士",
        "name": "神圣光环",
        "code": "AHpa",
        "levels": 3,
        "description": "为附近友方单位提供额外魔法抗性，并提高其受到的治疗效果。\n\n1级 - 15%魔法抗性，受到的治疗效果提高15%。\n2级 - 20%魔法抗性，受到的治疗效果提高20%。\n3级 - 25%魔法抗性，受到的治疗效果提高25%。"
      },
      {
        "hero": "被遗忘者圣骑士",
        "name": "净化之火",
        "code": "AHcl",
        "levels": 1,
        "description": "召唤圣光，移除附近友方单位的所有减益和附近敌方单位的所有增益。为友方单位治疗125点生命值，获得25%额外攻击力，持续25秒。每移除友方单位的一个减益，额外为该单位治疗50点生命值并获得15%额外攻击力。敌方单位昏迷3秒。\n对召唤单位造成400点伤害。"
      }
    ]
  },
